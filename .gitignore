# local secrets — never commit
# private keys of any kind (SSH, TLS) — never publish these
*.key
*.pem
*.ppk
id_rsa*
id_ed25519*
*.pub
.env
*.env
!*.env.example

# customer accounts, sessions and orders — personal data, never commit
site/data/accounts.json
site/data/accounts.json.tmp
site/data/accounts.json.migrated
# the SQLite account store and its write-ahead log — same personal data
site/data/accounts.db
site/data/accounts.db-*

# owner's catalogue overlay (product edits, custom items, hidden, settings) —
# runtime business data created and mutated on the server, like accounts.db
site/data/catalog-admin.db
site/data/catalog-admin.db-*
# Ecwid mirror — a CACHE of someone else's data, always safe to delete and
# re-sync. Runtime state, never committed.
site/data/ecwid.db
site/data/ecwid.db-*

# owner analytics — funnel events + cart-abandonment feedback, runtime data
site/data/analytics.db
site/data/analytics.db-*
# owner-uploaded product images — binary runtime data, live only on the server volume
site/data/uploads/

# engine runtime state
site/data/price-index.json
# SQLite write-ahead/session state — meaningless outside the writing process
site/data/catalog.db-*
site/server.out.log
site/server.err.log

# diagnostics output
scripts/adapter-report*.json
scripts/noparse-report.json
scripts/endpoint-report.json
scripts/adapter-sweep*.log
scripts/stores.backup.json

# intermediate render artifacts (167MB, regenerable from generation/prompts)
# NOTE: site/assets/vid IS tracked — the live site needs those files.
generation/out/
extraction/raw/
.playwright-mcp/

node_modules/

# SDD scratch
.superpowers/

# customer bookings — runtime data, never commit
site/data/bookings.json

# Claude Code worktrees (isolated workspaces; never committed)
.claude/worktrees/
