# Copy to `.env` (local) or /etc/sadko.env (server) and fill in.
# The site runs fully without any of these — they unlock optional features.

# --- Admin control room (site/admin.html) -----------------------------------
# Comma-separated list of the email addresses allowed into the owner console.
# An account becomes an administrator ONLY by signing in with one of these
# emails — nothing in the database or the browser can grant admin rights.
# Register a normal account with this email first, then sign in at /admin.html.
ADMIN_EMAILS=

# --- Google sign-in (optional) ----------------------------------------------
# Public OAuth client id (no secret needed). With it unset, the sign-in page
# shows an honest "not configured" note instead of a dead Google button.
GOOGLE_CLIENT_ID=

# --- AI relevance layer (optional) ------------------------------------------
# The price-comparison engine runs fully rule-based without these; every AI
# call falls back on failure.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
